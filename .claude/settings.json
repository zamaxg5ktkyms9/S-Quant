{
  "permissions": {
    "defaultMode": "dontAsk",
    "ask": [
      "Bash(rm -rf .git)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf ./.git*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin +*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog expire*)",
      "Bash(git update-ref -d*)",
      "Bash(rm /*)",
      "Bash(rm -r /*)",
      "Bash(rm -rf /*)",
      "Bash(rm ~*)",
      "Bash(rm -r ~*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm*)"
    ],
    "allow": [
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(tail)",
      "Bash(tail *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(cat)",
      "Bash(cat *)",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(du)",
      "Bash(du *)",
      "Bash(df)",
      "Bash(df *)",
      "Bash(tree)",
      "Bash(tree *)",
      "Bash(less *)",
      "Bash(more *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(echo)",
      "Bash(echo *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(ps)",
      "Bash(ps *)",
      "Bash(jobs)",
      "Bash(jobs *)",
      "Bash(history)",
      "Bash(history *)",
      "Bash(mkdir)",
      "Bash(mkdir *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git config --get *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(xargs grep *)",
      "Bash(xargs ls *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/post_session_hook.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
